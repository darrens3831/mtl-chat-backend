# Copie ce fichier en ".env" et remplis les vraies valeurs (ne JAMAIS partager ce fichier ni le mettre sur GitHub public)
# Sur Render : Dashboard > ton service > Environment.

# Stripe (paiements VIP)
STRIPE_SECRET_KEY=sk_test_remplace_moi
STRIPE_WEBHOOK_SECRET=whsec_remplace_moi

# Adresse du site, sans "/" a la fin (retour apres paiement)
FRONTEND_URL=https://mtlchats.com

# Cle secrete qui signe les jetons VIP (longue chaine aleatoire, a garder secrete)
VIP_TOKEN_SECRET=remplace_moi_par_une_longue_chaine_aleatoire

# Cloudflare TURN (video fiable sur reseaux mobiles)
CF_TURN_KEY_ID=remplace_moi
CF_TURN_API_TOKEN=remplace_moi

# Optionnel : delai (ms) avant de remettre les deux memes personnes ensemble apres "Suivant"
REMATCH_COOLDOWN_MS=10000

# Render definit PORT tout seul ; utile seulement en local
PORT=4242
